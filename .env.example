# Firebase Console > Project settings > General > "Your apps" > Web app
# altindaki config degerlerini buraya kopyalayin, sonra bu dosyayi .env
# olarak kaydedin. .env git'e eklenmez.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Giris yapabilecek iki e-posta (Firebase Authentication'da olusturulacak).
# Bu, Firestore kurallarindaki UID beyaz listesinin yaninda arayuz
# tarafinda ikinci bir kontrol katmanidir.
VITE_ALLOWED_EMAIL_1=canberk@example.com
VITE_ALLOWED_EMAIL_2=tugce@example.com
