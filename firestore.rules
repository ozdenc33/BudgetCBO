rules_version = '2';

// Yalnizca iki kimligi dogrulanmis kullanici (Can Berk, Tugce) okuyup
// yazabilir. UID'ler Firebase Console > Authentication > Users altindan
// alinir ve asagidaki listeye elle yazilir. Bkz. README.md "Kurulum" bolumu.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedUids() {
      return [
        'Ml3QFPvFMGV9w9SfPWOR97xKxnQ2', // Can Berk
        'Zo4l8zyn0TSKyf3ylXqQFELlG2R2'  // Tuğçe
      ];
    }

    function isAllowedUser() {
      return request.auth != null && request.auth.uid in allowedUids();
    }

    match /{document=**} {
      allow read, write: if isAllowedUser();
    }
  }
}
